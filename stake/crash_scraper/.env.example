# Optional generic HTTP webhook for operational alerts.
# Keep real credentials outside Git.
STAKE_CRASH_ALERT_WEBHOOK=

# Optional official Crash History API token.
# Requires approved Stake affiliate API access.
# Never commit the real token.
STAKE_CRASH_API_TOKEN=

# Usually leave this unchanged.
STAKE_CRASH_HISTORY_API_URL=https://api.stake.com/crash/history
